datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String
  interest  String
  message   String?
  createdAt DateTime @default(now())
}
